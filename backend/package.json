{
  "name": "viveka-backend",
  "version": "1.0.0",
  "description": "Backend API orchestrator for Viveka",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
