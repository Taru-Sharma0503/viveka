  {
    "id": "VIV_008",
    "source": {
      "title": "Complete Works of Swami Vivekananda",
      "author": "Swami Vivekananda",
      "work": "Lectures and Discourses",
      "edition": "15th Edition",
      "publisher": "Advaita Ashrama",
      "section": "Volume 1",
      "sourceUrl": "https://www.ramakrishnamath.in/cwsv"
    },
    "text": "Face the brute. That is the lesson for all life—face the terrible, face it boldly. Like the monkeys on the ramparts of Benares, the more we flee, the more they pursue. Face the danger, face the trial, face the difficulty.",
    "locationLabel": "Volume 1, What is Religion?",
    "language": "en",
    "topics": [
      "fear",
      "courage",
      "action"
    ],
    "verified": true
  },
  {
